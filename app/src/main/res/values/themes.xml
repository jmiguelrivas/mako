<resources>
    <!-- Base theme -->
    <style name="Theme.Mako" parent="Theme.Rama.Base">
        <item name="bgColor">@color/bg_1</item>
    </style>

    <style name="PinButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">8sp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:background">@color/bg_3</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="InfoButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:src">@drawable/px_info</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/accent_1</item>
        <item name="android:scaleType">center</item>
    </style>

</resources>