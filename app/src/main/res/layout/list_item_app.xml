<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_row"
    android:gravity="center"
    android:layout_gravity="center"
    android:descendantFocusability="blocksDescendants"
    style="@style/HorizontalList">

    <ImageView
        android:id="@+id/selection_check"
        android:layout_width="24sp"
        android:layout_height="24sp"
        android:src="@drawable/px_octagon_check"
        android:visibility="gone"
        android:paddingEnd="8sp"
        android:contentDescription="@string/altdescr_selection_check" />

    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="32sp"
        android:layout_height="32sp"
        android:focusable="false"
        android:paddingEnd="8sp" />

    <TextView
        android:id="@+id/open_app_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="12sp"
        android:paddingBottom="12sp"
        android:paddingEnd="30sp"
        android:focusable="false"
        android:clickable="false"
        android:textSize="32sp"
        android:textColor="@color/foreground" />

    <LinearLayout
        android:id="@+id/empty_space"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:focusable="false"
        android:clickable="false"
        android:gravity="center_vertical|end"
        android:layout_weight="1"
        android:paddingEnd="@dimen/small"
        style="@style/VerticalListDividedSmall">

        <LinearLayout
            android:id="@+id/api"
            android:layout_width="wrap_content"
            android:minWidth="35sp"
            android:gravity="end"
            style="@style/HorizontalList">

            <TextView
                android:id="@+id/min_api"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/disabled"
                android:textSize="@dimen/small" />

            <TextView
                android:id="@+id/api_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/disabled"
                android:textSize="@dimen/small"
                android:text="-" />

            <TextView
                android:id="@+id/target_api"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/disabled"
                android:textSize="@dimen/small" />
        </LinearLayout>

        <TextView
            android:id="@+id/app_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/disabled"
            android:textSize="@dimen/small" />
    </LinearLayout>
</LinearLayout>
