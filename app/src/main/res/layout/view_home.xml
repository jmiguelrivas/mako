<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:background="?attr/bgColor"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/VerticalListDivided">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <include layout="@layout/home_list_header" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/app_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchbar"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/search_field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/bg_2"
            android:textColorHint="@color/disabled"
            android:hint="@string/hint_search_apps"
            android:visibility="gone"
            style="@style/EditText" />

        <FrameLayout
            android:id="@+id/clear_field"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12sp"
            android:visibility="gone">

            <ImageView
                android:src="@drawable/px_times"
                android:contentDescription="@string/altdescr_clear_search"
                style="@style/Icon24" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_bar"
        android:visibility="gone"
        android:padding="4sp"
        style="@style/HorizontalList_BG2">

        <FrameLayout
            android:id="@+id/multi_select_cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12sp">

            <ImageView
                android:src="@drawable/px_arrow_left"
                android:contentDescription="@string/btn_cancel"
                style="@style/Icon24" />
        </FrameLayout>

        <TextView
            android:id="@+id/selected_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textColor="@color/foreground" />

        <FrameLayout
            android:id="@+id/rename_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12sp">

            <ImageView
                android:src="@drawable/px_edit"
                android:contentDescription="@string/ctxmenu_rename_app"
                style="@style/Icon24" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/move_to_group_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12sp">

            <ImageView
                android:src="@drawable/px_folder_enter"
                android:contentDescription="@string/ctxmenu_move_to_group"
                style="@style/Icon24" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/app_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12sp">

            <ImageView
                android:id="@+id/app_settings_icon"
                android:src="@drawable/px_cog"
                android:contentDescription="@string/ctxmenu_open_settings"
                style="@style/Icon24" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>